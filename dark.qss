/* =========================================================
   PyForge — "Darcula Night" theme
   JetBrains New UI / PyCharm inspired
   ---------------------------------------------------------
   Window / editor ..... #1E1F22     Panels / toolbars .. #2B2D30
   Border .............. #393B40     Input border ....... #4E5157
   Text ................ #DFE1E5     Secondary text ..... #868A91
   Disabled ............ #5A5D63     Hover .............. #393B40
   Selection ........... #2E436E     Accent ............. #3574F0
   ========================================================= */


/* =========================================================
   GLOBAL
   ========================================================= */

* {
    font-family: "Inter", "Segoe UI";
    font-size: 9pt;
    outline: none;
}

QMainWindow,
QDialog {
    background-color: #1E1F22;
    color: #DFE1E5;
}

QWidget {
    color: #DFE1E5;
}

QWidget:disabled {
    color: #5A5D63;
}

QLabel {
    background-color: transparent;
}

QMainWindow::separator {
    background-color: #393B40;
    width: 1px;
    height: 1px;
}

QMainWindow::separator:hover {
    background-color: #3574F0;
}


/* =========================================================
   MENU BAR
   ========================================================= */

QMenuBar {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: none;
    border-bottom: 1px solid #393B40;
    padding: 2px 6px;
}

QMenuBar::item {
    background-color: transparent;
    color: #DFE1E5;
    padding: 5px 9px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #393B40;
}

QMenuBar::item:pressed {
    background-color: #43454A;
}


/* =========================================================
   MENUS
   ========================================================= */

QMenu {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #43454A;
    padding: 5px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 30px 6px 12px;
    margin: 1px 0px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2E436E;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #5A5D63;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #393B40;
    margin: 5px 8px;
}


/* =========================================================
   TOOLBAR
   ========================================================= */

QToolBar {
    background-color: #2B2D30;
    border: none;
    border-bottom: 1px solid #393B40;
    spacing: 3px;
    padding: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: #DFE1E5;
    border: none;
    border-radius: 5px;
    padding: 5px;
}

QToolButton:hover {
    background-color: #393B40;
}

QToolButton:pressed {
    background-color: #43454A;
}

QToolButton:checked {
    background-color: #2E436E;
    color: #FFFFFF;
}

QToolButton:disabled {
    color: #5A5D63;
}

QToolBar::separator {
    width: 1px;
    background-color: #393B40;
    margin: 4px 6px;
}


/* =========================================================
   DOCK WIDGETS  (tool windows)
   ========================================================= */

QDockWidget {
    color: #DFE1E5;
    background-color: #2B2D30;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #2B2D30;
    color: #DFE1E5;
    font-weight: normal;
    text-align: left;
    padding: 7px 12px;
    border: none;
    border-bottom: 1px solid #393B40;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #43454A;
}


/* =========================================================
   TREE / LIST / FILE EXPLORER
   ========================================================= */

QTreeWidget,
QTreeView,
QListWidget,
QListView {
    background-color: #2B2D30;
    alternate-background-color: #2B2D30;
    color: #DFE1E5;
    border: none;
    padding: 4px;
    show-decoration-selected: 1;
    selection-background-color: #2E436E;
    selection-color: #FFFFFF;
}

QTreeWidget::item,
QTreeView::item,
QListWidget::item,
QListView::item {
    padding: 4px 6px;
    border-radius: 4px;
}

QTreeWidget::item:hover,
QTreeView::item:hover,
QListWidget::item:hover,
QListView::item:hover {
    background-color: #393B40;
}

QTreeWidget::item:selected,
QTreeView::item:selected,
QListWidget::item:selected,
QListView::item:selected {
    background-color: #2E436E;
    color: #FFFFFF;
}

QTreeWidget::item:selected:!active,
QTreeView::item:selected:!active,
QListWidget::item:selected:!active,
QListView::item:selected:!active {
    background-color: #43454A;
    color: #DFE1E5;
}


/* =========================================================
   TABLES / HEADERS
   ========================================================= */

QTableView,
QTableWidget {
    background-color: #1E1F22;
    alternate-background-color: #212226;
    gridline-color: #393B40;
    border: 1px solid #393B40;
    selection-background-color: #2E436E;
    selection-color: #FFFFFF;
}

QHeaderView {
    background-color: #2B2D30;
    border: none;
}

QHeaderView::section {
    background-color: #2B2D30;
    color: #868A91;
    padding: 5px 8px;
    border: none;
    border-bottom: 1px solid #393B40;
    border-right: 1px solid #393B40;
}


/* =========================================================
   TABS  (editor tabs — accent underline like IntelliJ)
   ========================================================= */

QTabWidget {
    background-color: #1E1F22;
}

QTabWidget::pane {
    background-color: #1E1F22;
    border: none;
    border-top: 1px solid #393B40;
}

QTabBar {
    background-color: #2B2D30;
    border: none;
}

QTabBar::tab {
    background-color: #2B2D30;
    color: #868A91;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 7px 16px 5px 16px;
    margin: 0px;
    min-width: 70px;
}

QTabBar::tab:hover {
    background-color: #393B40;
    color: #DFE1E5;
}

QTabBar::tab:selected {
    background-color: #1E1F22;
    color: #FFFFFF;
    border-bottom: 3px solid #3574F0;
}


/* =========================================================
   CODE EDITOR
   ========================================================= */

PythonCodeEditor {
    font-family: "JetBrains Mono";
    font-size: 10pt;
}

QTabWidget#MainEditorTabs QPlainTextEdit {
    font-family: "JetBrains Mono";
    font-size: 10pt;
}

QPlainTextEdit,
QTextEdit {
    background-color: #1E1F22;
    color: #BCBEC4;
    border: none;
    selection-background-color: #214283;
    selection-color: #FFFFFF;
    padding: 6px;
}


/* =========================================================
   TERMINAL / CONSOLE
   ========================================================= */

QPlainTextEdit#terminalOutput,
QPlainTextEdit#consoleOutput {
    background-color: #1E1F22;
    color: #BCBEC4;
    font-family: "JetBrains Mono";
    font-size: 9pt;
    border: none;
    border-top: 1px solid #393B40;
    padding: 8px;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #1E1F22;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 5px;
    padding: 5px 8px;
    selection-background-color: #214283;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #6F737A;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #3574F0;
}

QLineEdit:disabled {
    background-color: #2B2D30;
    border-color: #393B40;
    color: #5A5D63;
}


/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 5px;
    padding: 5px 16px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #393B40;
    border-color: #6F737A;
}

QPushButton:pressed {
    background-color: #43454A;
}

QPushButton:focus {
    border-color: #3574F0;
}

QPushButton:default {
    background-color: #3574F0;
    border: 1px solid #3574F0;
    color: #FFFFFF;
}

QPushButton:default:hover {
    background-color: #4682FA;
    border-color: #4682FA;
}

QPushButton:default:pressed {
    background-color: #2F65D6;
    border-color: #2F65D6;
}

QPushButton:disabled {
    background-color: #2B2D30;
    border-color: #393B40;
    color: #5A5D63;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

QComboBox {
    background-color: #1E1F22;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 5px;
    padding: 5px 8px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #6F737A;
}

QComboBox:focus,
QComboBox:on {
    border-color: #3574F0;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #868A91;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #43454A;
    padding: 3px;
    selection-background-color: #2E436E;
    selection-color: #FFFFFF;
}


/* =========================================================
   CHECKBOX / RADIO
   ========================================================= */

QCheckBox,
QRadioButton {
    color: #DFE1E5;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4E5157;
    border-radius: 3px;
    background-color: #1E1F22;
}

QCheckBox::indicator:hover {
    border-color: #6F737A;
}

QCheckBox::indicator:checked {
    background-color: #3574F0;
    border-color: #3574F0;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4E5157;
    border-radius: 8px;
    background-color: #1E1F22;
}

QRadioButton::indicator:hover {
    border-color: #6F737A;
}

QRadioButton::indicator:checked {
    border-color: #3574F0;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #FFFFFF, stop:0.38 #FFFFFF, stop:0.42 #3574F0, stop:1 #3574F0);
}


/* =========================================================
   GROUP BOX / PROGRESS / SLIDER
   ========================================================= */

QGroupBox {
    border: 1px solid #393B40;
    border-radius: 6px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0px 4px;
    color: #868A91;
}

QProgressBar {
    background-color: #393B40;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #3574F0;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #393B40;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #3574F0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0px;
    border-radius: 6px;
    background-color: #DFE1E5;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
}


/* =========================================================
   SCROLL BARS  (thin, translucent — IntelliJ style)
   ========================================================= */

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: rgba(134, 138, 145, 90);
    min-height: 30px;
    border-radius: 4px;
    margin: 1px 1px 1px 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(134, 138, 145, 160);
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: rgba(134, 138, 145, 90);
    min-width: 30px;
    border-radius: 4px;
    margin: 2px 1px 1px 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(134, 138, 145, 160);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}


/* =========================================================
   STATUS BAR
   ========================================================= */

QStatusBar {
    background-color: #2B2D30;
    color: #868A91;
    border-top: 1px solid #393B40;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #868A91;
    padding: 0px 6px;
}


/* =========================================================
   SPLITTERS
   ========================================================= */

QSplitter::handle {
    background-color: #393B40;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #3574F0;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #43454A;
    padding: 5px 8px;
}


/* =========================================================
   DIALOGS
   ========================================================= */

QDialog {
    background-color: #2B2D30;
}

QDialog QLabel {
    color: #DFE1E5;
}

QDialog QLabel#TitleLabel {
    color: #FFFFFF;
    font-size: 15pt;
    font-weight: bold;
}

QDialog QLabel#DescriptionLabel {
    color: #868A91;
    font-size: 9pt;
}

QDialog QScrollArea {
    background-color: #1E1F22;
    border: 1px solid #393B40;
    border-radius: 6px;
}

QDialog QScrollArea > QWidget > QWidget {
    background-color: #1E1F22;
}

QMessageBox {
    background-color: #2B2D30;
}

QMessageBox QPushButton {
    min-width: 72px;
}


/* =========================================================
   SYNTAX COLORS (for your Python highlighter — not QSS)
   ---------------------------------------------------------
   Keyword ....... #CF8E6D     String ........ #6AAB73
   Number ........ #2AACB8     Comment ....... #7A7E85
   Function def .. #56A8F5     Decorator ..... #B3AE60
   Builtin/Class . #C77DBB     Self/param .... #94558D
   Default text .. #BCBEC4     Current line .. #26282E
   Gutter bg ..... #1E1F22     Line numbers .. #4B5059
   Selection ..... #214283     Matching brace  #43454A
   ========================================================= */
