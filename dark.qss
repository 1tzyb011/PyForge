/* =========================================================
   GLOBAL
   ========================================================= */

* {
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow {
    background-color: #18181b;
    color: #e4e4e7;
}

QWidget {
    color: #e4e4e7;
}


/* =========================================================
   MENU BAR
   ========================================================= */

QMenuBar {
    background-color: #202023;
    color: #d4d4d8;
    border: none;
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    color: #d4d4d8;
    padding: 5px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #2b2b2f;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #333338;
}


/* =========================================================
   MENUS
   ========================================================= */

QMenu {
    background-color: #242427;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    padding: 5px;
}

QMenu::item {
    background-color: transparent;
    color: #e4e4e7;
    padding: 7px 28px 7px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b2f63;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #3f3f46;
    margin: 5px 8px;
}


/* =========================================================
   TOOLBAR
   ========================================================= */

QToolBar {
    background-color: #202023;
    border: none;
    border-bottom: 1px solid #2f2f33;
    spacing: 4px;
    padding: 5px 7px;
}

QToolButton {
    background-color: transparent;
    color: #d4d4d8;
    border: none;
    border-radius: 6px;
    padding: 6px;
}

QToolButton:hover {
    background-color: #2b2b2f;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #36363b;
}

QToolButton:checked {
    background-color: #3b2f63;
    color: #ffffff;
}

QToolBar::separator {
    width: 1px;
    background-color: #3f3f46;
    margin: 4px 6px;
}


/* =========================================================
   DOCK WIDGETS
   ========================================================= */

QDockWidget {
    color: #e4e4e7;
    background-color: #202023;
}

QDockWidget::title {
    background-color: #242427;
    color: #ffffff;
    font-weight: bold;
    padding: 7px 10px;
    border: none;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 3px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #3a3a3f;
    border-radius: 4px;
}


/* =========================================================
   TREE / FILE EXPLORER
   ========================================================= */

QTreeWidget,
QTreeView {
    background-color: #202023;
    color: #d4d4d8;
    border: none;
    outline: none;
    padding: 4px;
}

QTreeWidget::item,
QTreeView::item {
    padding: 5px 7px;
    border-radius: 4px;
}

QTreeWidget::item:hover,
QTreeView::item:hover {
    background-color: #2b2b2f;
}

QTreeWidget::item:selected,
QTreeView::item:selected {
    background-color: #3b2f63;
    color: #ffffff;
}


/* =========================================================
   TABS
   ========================================================= */

QTabWidget {
    background-color: #18181b;
}

QTabWidget::pane {
    background-color: #18181b;
    border: none;
}

QTabBar {
    background-color: #202023;
    border: none;
}

QTabBar::tab {
    background-color: #202023;
    color: #a1a1aa;
    border: none;
    padding: 8px 16px;
    margin: 0px;
    min-width: 70px;
}

QTabBar::tab:hover {
    background-color: #2b2b2f;
    color: #e4e4e7;
}

QTabBar::tab:selected {
    background-color: #18181b;
    color: #ffffff;
    border-bottom: 2px solid #7c3aed;
}


/* =========================================================
   CODE EDITOR
   ========================================================= */

QPlainTextEdit,
QTextEdit {
    background-color: #18181b;
    color: #e4e4e7;
    border: none;
    selection-background-color: #3b2f63;
    selection-color: #ffffff;
    padding: 8px;
}

QPlainTextEdit:focus,
QTextEdit:focus {
    border: none;
}


/* =========================================================
   TERMINAL / CONSOLE
   ========================================================= */

QPlainTextEdit#terminalOutput,
QPlainTextEdit#consoleOutput {
    background-color: #111113;
    color: #d4d4d8;
    border: none;
    padding: 8px;
}


/* =========================================================
   LINE EDIT
   ========================================================= */

QLineEdit {
    background-color: #242427;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 9px;
    selection-background-color: #3b2f63;
}

QLineEdit:hover {
    border-color: #52525b;
}

QLineEdit:focus {
    border-color: #7c3aed;
}


/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background-color: #2b2b2f;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #333338;
    border-color: #52525b;
}

QPushButton:pressed {
    background-color: #3f3f46;
}

QPushButton:focus {
    border-color: #7c3aed;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

QComboBox {
    background-color: #242427;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 9px;
}

QComboBox:hover {
    border-color: #52525b;
}

QComboBox:focus {
    border-color: #7c3aed;
}

QComboBox QAbstractItemView {
    background-color: #242427;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    selection-background-color: #3b2f63;
    selection-color: #ffffff;
}


/* =========================================================
   CHECKBOX
   ========================================================= */

QCheckBox {
    color: #d4d4d8;
    spacing: 7px;
}

QCheckBox:hover {
    color: #ffffff;
}


/* =========================================================
   SCROLL BARS
   ========================================================= */

QScrollBar:vertical {
    background-color: #18181b;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #3f3f46;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #52525b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #18181b;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #3f3f46;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #52525b;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* =========================================================
   STATUS BAR
   ========================================================= */

QStatusBar {
    background-color: #202023;
    color: #a1a1aa;
    border-top: 1px solid #2f2f33;
}

QStatusBar::item {
    border: none;
}


/* =========================================================
   SPLITTERS
   ========================================================= */

QSplitter::handle {
    background-color: #2f2f33;
}

QSplitter::handle:hover {
    background-color: #7c3aed;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #242427;
    color: #ffffff;
    border: 1px solid #3f3f46;
    padding: 5px 8px;
}

QTabWidget#MainEditorTabs QPlainTextEdit {
    font-family: "Jetbrains Mono";
}
