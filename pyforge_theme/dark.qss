/* =========================================================
   PyForge — IntelliJ IDEA "New UI Dark" inspired theme

   Palette
   ---------------------------------------------------------
   window / panels   #2B2D30
   editor            #1E1F22
   borders           #393B40
   input border      #4E5157
   hover             #393B40
   selection         #2E436E   (inactive: #43454A)
   accent            #3574F0   (hover #4682FA, pressed #2F65CA)
   text              #DFE1E5
   text secondary    #9DA0A8
   text disabled     #6F737A
   ========================================================= */


/* =========================================================
   GLOBAL
   ========================================================= */

* {
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 13px;
    outline: none;
}

QWidget {
    background-color: #2B2D30;
    color: #DFE1E5;
}

QWidget:disabled {
    color: #6F737A;
}

QMainWindow {
    background-color: #2B2D30;
}

QMainWindow::separator {
    background-color: #1E1F22;
    width: 1px;
    height: 1px;
}

QMainWindow::separator:hover {
    background-color: #3574F0;
}

QLabel {
    background-color: transparent;
}

QFrame {
    border: none;
}


/* =========================================================
   MENU BAR
   ========================================================= */

QMenuBar {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: none;
    border-bottom: 1px solid #1E1F22;
    padding: 2px 6px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 9px;
    margin: 1px 1px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #393B40;
}

QMenuBar::item:pressed {
    background-color: #43454A;
}


/* =========================================================
   MENUS
   ========================================================= */

QMenu {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 30px 6px 24px;
    margin: 1px 0px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2E436E;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #6F737A;
    background-color: transparent;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background-color: #393B40;
    margin: 5px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

QMenu::indicator:non-exclusive:checked {
    image: url(@ICONS@/menu_check.png);
}


/* =========================================================
   TOOLBAR
   ========================================================= */

QToolBar {
    background-color: #2B2D30;
    border: none;
    border-bottom: 1px solid #1E1F22;
    spacing: 2px;
    padding: 4px 8px;
}

QToolBar::handle {
    width: 0px;
    height: 0px;
}

QToolBar::separator {
    width: 1px;
    background-color: #393B40;
    margin: 5px 7px;
}

QToolButton {
    background-color: transparent;
    color: #DFE1E5;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 6px;
}

QToolButton:hover {
    background-color: #393B40;
}

QToolButton:pressed {
    background-color: #43454A;
}

QToolButton:checked {
    background-color: #2E436E;
    color: #FFFFFF;
}

QToolButton:disabled {
    color: #6F737A;
}

QToolButton::menu-indicator {
    image: url(@ICONS@/arrow_down.png);
    width: 8px;
    height: 8px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 2px;
}


/* =========================================================
   DOCK WIDGETS (tool windows)
   ========================================================= */

QDockWidget {
    color: #DFE1E5;
    background-color: #2B2D30;
    titlebar-close-icon: url(@ICONS@/close.png);
    titlebar-normal-icon: url(@ICONS@/float.png);
}

QDockWidget::title {
    background-color: #2B2D30;
    color: #DFE1E5;
    font-weight: 600;
    text-align: left;
    padding: 7px 10px;
    border: none;
    border-bottom: 1px solid #1E1F22;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
    subcontrol-position: top right;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #43454A;
}


/* =========================================================
   TREE / FILE EXPLORER / LISTS
   ========================================================= */

QTreeWidget,
QTreeView,
QListWidget,
QListView {
    background-color: #2B2D30;
    alternate-background-color: #2B2D30;
    color: #DFE1E5;
    border: none;
    padding: 3px;
    show-decoration-selected: 1;
}

QTreeWidget::item,
QTreeView::item,
QListWidget::item,
QListView::item {
    padding: 4px 6px;
    border-radius: 4px;
    min-height: 20px;
}

QTreeWidget::item:hover,
QTreeView::item:hover,
QListWidget::item:hover,
QListView::item:hover {
    background-color: #393B40;
}

QTreeWidget::item:selected,
QTreeView::item:selected,
QListWidget::item:selected,
QListView::item:selected {
    background-color: #2E436E;
    color: #FFFFFF;
}

QTreeWidget::item:selected:!active,
QTreeView::item:selected:!active,
QListWidget::item:selected:!active,
QListView::item:selected:!active {
    background-color: #43454A;
    color: #DFE1E5;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(@ICONS@/arrow_right.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(@ICONS@/arrow_down.png);
}


/* =========================================================
   TABLES / HEADERS
   ========================================================= */

QTableView,
QTableWidget {
    background-color: #2B2D30;
    alternate-background-color: #2E3033;
    gridline-color: #393B40;
    border: 1px solid #393B40;
    selection-background-color: #2E436E;
    selection-color: #FFFFFF;
}

QHeaderView {
    background-color: #2B2D30;
}

QHeaderView::section {
    background-color: #2B2D30;
    color: #9DA0A8;
    border: none;
    border-right: 1px solid #393B40;
    border-bottom: 1px solid #393B40;
    padding: 5px 8px;
}

QTableCornerButton::section {
    background-color: #2B2D30;
    border: none;
}


/* =========================================================
   EDITOR TABS
   ========================================================= */

QTabWidget {
    background-color: #1E1F22;
}

QTabWidget::pane {
    background-color: #1E1F22;
    border: none;
    border-top: 1px solid #393B40;
    top: -1px;
}

QTabBar {
    background-color: #2B2D30;
    border: none;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #2B2D30;
    color: #9DA0A8;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 7px 14px 5px 14px;
    margin: 0px;
    min-width: 60px;
}

QTabBar::tab:hover {
    background-color: #2E3033;
    color: #DFE1E5;
}

QTabBar::tab:selected {
    background-color: #1E1F22;
    color: #FFFFFF;
    border-bottom: 3px solid #3574F0;
}

QTabBar::tab:!selected:!hover {
    background-color: #2B2D30;
}

QTabBar::close-button {
    image: url(@ICONS@/close.png);
    subcontrol-position: right;
    border-radius: 3px;
    margin-left: 4px;
    padding: 2px;
}

QTabBar::close-button:hover {
    image: url(@ICONS@/close_hover.png);
    background-color: #4E5157;
}

QTabBar::scroller {
    width: 22px;
}

QTabBar QToolButton {
    background-color: #2B2D30;
    border: none;
    border-radius: 0px;
}

QTabBar QToolButton:hover {
    background-color: #393B40;
}

QTabBar QToolButton::left-arrow {
    image: url(@ICONS@/arrow_left.png);
}

QTabBar QToolButton::right-arrow {
    image: url(@ICONS@/arrow_right.png);
}


/* =========================================================
   CODE EDITOR
   ========================================================= */

QPlainTextEdit,
QTextEdit,
QTextBrowser {
    background-color: #1E1F22;
    color: #BCBEC4;
    border: none;
    selection-background-color: #214283;
    selection-color: #FFFFFF;
    padding: 6px;
}

PythonCodeEditor {
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 13px;
    background-color: #1E1F22;
    color: #BCBEC4;
    selection-background-color: #214283;
    selection-color: #FFFFFF;
    border: none;
}

QTabWidget#MainEditorTabs QPlainTextEdit {
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 13px;
}


/* =========================================================
   TERMINAL / CONSOLE
   ========================================================= */

QPlainTextEdit#terminalOutput,
QPlainTextEdit#consoleOutput {
    background-color: #1E1F22;
    color: #BCBEC4;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    border: none;
    padding: 8px;
    selection-background-color: #214283;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 20px;
    selection-background-color: #2E436E;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #6F737A;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #3574F0;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #2B2D30;
    border-color: #393B40;
    color: #6F737A;
}

QLineEdit:read-only {
    background-color: #2E3033;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #393B40;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(@ICONS@/arrow_up.png);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(@ICONS@/arrow_down.png);
    width: 8px;
    height: 8px;
}


/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 5px;
    padding: 5px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #393B40;
    border-color: #6F737A;
}

QPushButton:pressed {
    background-color: #43454A;
}

QPushButton:focus {
    border: 1px solid #3574F0;
}

QPushButton:disabled {
    background-color: #2B2D30;
    border-color: #393B40;
    color: #6F737A;
}

/* Primary action — default button or setProperty("primary", True) / objectName "PrimaryButton" */
QPushButton:default,
QPushButton#PrimaryButton,
QPushButton[primary="true"] {
    background-color: #3574F0;
    color: #FFFFFF;
    border: 1px solid #3574F0;
    font-weight: 600;
}

QPushButton:default:hover,
QPushButton#PrimaryButton:hover,
QPushButton[primary="true"]:hover {
    background-color: #4682FA;
    border-color: #4682FA;
}

QPushButton:default:pressed,
QPushButton#PrimaryButton:pressed,
QPushButton[primary="true"]:pressed {
    background-color: #2F65CA;
    border-color: #2F65CA;
}

/* Run / success action — objectName "RunButton" */
QPushButton#RunButton {
    background-color: #5FB865;
    color: #1E1F22;
    border: 1px solid #5FB865;
    font-weight: 600;
}

QPushButton#RunButton:hover {
    background-color: #73C97A;
    border-color: #73C97A;
}

QPushButton#RunButton:pressed {
    background-color: #4E9F54;
}

/* Stop / destructive action — objectName "StopButton" */
QPushButton#StopButton {
    background-color: #DB5C5C;
    color: #FFFFFF;
    border: 1px solid #DB5C5C;
    font-weight: 600;
}

QPushButton#StopButton:hover {
    background-color: #E67474;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

QComboBox {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #6F737A;
}

QComboBox:focus,
QComboBox:on {
    border: 1px solid #3574F0;
}

QComboBox:disabled {
    border-color: #393B40;
    color: #6F737A;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(@ICONS@/arrow_down.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #2B2D30;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 4px;
    padding: 3px;
    selection-background-color: #2E436E;
    selection-color: #FFFFFF;
    outline: none;
}


/* =========================================================
   CHECKBOX / RADIO
   ========================================================= */

QCheckBox,
QRadioButton {
    background-color: transparent;
    color: #DFE1E5;
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #2B2D30;
    border: 1px solid #6F737A;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #3574F0;
}

QCheckBox::indicator:checked {
    background-color: #3574F0;
    border: 1px solid #3574F0;
    image: url(@ICONS@/check.png);
}

QRadioButton::indicator:checked {
    background-color: #3574F0;
    border: 1px solid #3574F0;
    image: url(@ICONS@/radio_dot.png);
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #2B2D30;
    border-color: #393B40;
}


/* =========================================================
   GROUP BOX
   ========================================================= */

QGroupBox {
    background-color: transparent;
    border: 1px solid #393B40;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #9DA0A8;
    background-color: #2B2D30;
}


/* =========================================================
   PROGRESS BAR / SLIDER
   ========================================================= */

QProgressBar {
    background-color: #393B40;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #3574F0;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #393B40;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #3574F0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background-color: #DFE1E5;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
}


/* =========================================================
   SCROLL BARS (slim, IntelliJ style)
   ========================================================= */

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #4E5157;
    min-height: 32px;
    margin: 2px 2px 2px 3px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6F737A;
}

QScrollBar::handle:vertical:pressed {
    background-color: #868A91;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #4E5157;
    min-width: 32px;
    margin: 3px 2px 2px 2px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6F737A;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #868A91;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

QAbstractScrollArea::corner {
    background-color: transparent;
}


/* =========================================================
   STATUS BAR
   ========================================================= */

QStatusBar {
    background-color: #2B2D30;
    color: #9DA0A8;
    border: none;
    border-top: 1px solid #1E1F22;
    padding: 0px 6px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #9DA0A8;
    padding: 0px 8px;
}


/* =========================================================
   SPLITTERS
   ========================================================= */

QSplitter::handle {
    background-color: #1E1F22;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #3574F0;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #393B40;
    color: #DFE1E5;
    border: 1px solid #4E5157;
    border-radius: 4px;
    padding: 5px 8px;
}


/* =========================================================
   DIALOGS
   ========================================================= */

QDialog {
    background-color: #2B2D30;
    color: #DFE1E5;
}

QDialog QLabel {
    color: #DFE1E5;
}

QDialog QLabel#TitleLabel {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
}

QDialog QLabel#DescriptionLabel {
    color: #9DA0A8;
    font-size: 13px;
}

QDialog QScrollArea {
    background-color: #1E1F22;
    border: 1px solid #393B40;
    border-radius: 6px;
}

QDialog QScrollArea > QWidget > QWidget {
    background-color: #1E1F22;
}

QMessageBox {
    background-color: #2B2D30;
}

QMessageBox QLabel {
    color: #DFE1E5;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}


/* =========================================================
   MISC
   ========================================================= */

QSizeGrip {
    background-color: transparent;
}

QAbstractItemView {
    outline: none;
}

QStackedWidget {
    background-color: transparent;
}

QScrollArea {
    background-color: transparent;
    border: none;
}
